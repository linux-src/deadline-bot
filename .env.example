# Токен бота, выданный @BotFather
BOT_TOKEN=

# Чат (или супергруппа с темами), куда бот публикует карточки временных изменений.
# Можно узнать через @userinfobot / @RawDataBot, либо командой /chatid внутри чата.
CARD_CHAT_ID=

# Необязательно: id темы (topic) внутри супергруппы, если карточки должны идти в отдельную тему
CARD_THREAD_ID=

# Список ботов, между которыми можно распределять изменение (через запятую, без пробелов)
BOTS=TATI,DREAM,SECRET,IMREQ,ZAKON

# Часовой пояс для расчёта сроков и отображения времени
TIMEZONE=Europe/Moscow

# За сколько минут до дедлайна присылать напоминание ответственному
REMINDER_MINUTES_BEFORE=60

# Раз во сколько минут повторять напоминание о просроченном/требующем проверки изменении
ESCALATION_MINUTES=45

# Путь к файлу базы данных SQLite
DB_PATH=data/deadline_bot.db
